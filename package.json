{
  "name": "revival-fellowship-international",
  "version": "1.0.0",
  "description": "Node.js MVC version of Revival Fellowship International website",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "build:css": "tailwindcss -i ./styles/tailwind.css -o ./public/styles/site.css --minify",
    "watch:css": "tailwindcss -i ./styles/tailwind.css -o ./public/styles/site.css --watch",
    "vercel-build": "npm run build:css"
  },
  "keywords": [
    "church",
    "ministry",
    "express",
    "ejs",
    "mvc"
  ],
  "author": "Letlotlo Hlaoli (converted to Node.js MVC)",
  "license": "MIT",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.1",
    "mongodb": "^6.8.0",
    "nodemailer": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "tailwindcss": "^3.4.17"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
