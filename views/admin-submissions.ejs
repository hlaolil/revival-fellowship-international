<%- include('partials/admin-header', { title, currentSection }) %>

<% const typeLabel = t => t ? t.replace(/-/g,' ').replace(/\b\w/g,l=>l.toUpperCase()) : 'Unknown'; %>
<% const types = ['prayer-request', 'appointment-request', 'membership-request', 'information-request']; %>

<div class="flex flex-wrap justify-between items-center gap-4 mb-8">
  <form method="GET" action="/admin/submissions" class="flex flex-wrap gap-3">
    <select name="type" class="p-2 border border-gray-300 rounded-lg text-sm" onchange="this.form.submit()">
      <option value="">All types</option>
      <% types.forEach(t => { %>
        <option value="<%= t %>" <%= type === t ? 'selected' : '' %>><%= typeLabel(t) %></option>
      <% }) %>
    </select>
    <select name="status" class="p-2 border border-gray-300 rounded-lg text-sm" onchange="this.form.submit()">
      <option value="">Any status</option>
      <option value="new" <%= status === 'new' ? 'selected' : '' %>>New</option>
      <option value="handled" <%= status === 'handled' ? 'selected' : '' %>>Handled</option>
    </select>
    <noscript><button class="bg-primary text-white px-4 rounded-lg text-sm">Filter</button></noscript>
  </form>
  <div class="flex items-center gap-4">
    <p class="text-gray-500 text-sm"><%= submissions.length %> shown</p>
    <a href="/admin/submissions/export" class="bg-primary text-white px-5 py-2 rounded-full font-semibold hover:bg-accent transition text-sm">
      <i class="fas fa-file-csv mr-2"></i>Export CSV
    </a>
  </div>
</div>

<% if (submissions.length === 0) { %>
  <div class="bg-white rounded-2xl shadow p-16 text-center text-gray-400">
    <i class="fas fa-inbox text-5xl mb-4"></i>
    <p class="text-lg">No enquiries match this filter.</p>
  </div>
<% } %>

<div class="space-y-4">
  <% submissions.forEach(s => { const handled = s.status === 'handled'; %>
    <div class="bg-white rounded-2xl shadow p-6 <%= handled ? 'opacity-70' : 'border-l-4 border-secondary' %>">
      <div class="flex flex-wrap justify-between gap-4 mb-3">
        <div>
          <p class="font-bold text-gray-800 text-lg"><%= s.firstName %> <%= s.lastName %></p>
          <p class="text-sm text-gray-500">
            <a href="mailto:<%= s.email %>" class="text-primary hover:underline"><i class="fas fa-envelope mr-1"></i><%= s.email %></a>
            &nbsp;&bull;&nbsp;
            <a href="tel:<%= s.phone %>" class="text-primary hover:underline"><i class="fas fa-phone mr-1"></i><%= s.phone %></a>
          </p>
        </div>
        <div class="text-right">
          <span class="bg-primary/10 text-primary px-3 py-1 rounded-full text-xs font-bold"><%= typeLabel(s.enquiryType) %></span>
          <p class="text-xs text-gray-400 mt-2"><%= s.submittedAt ? new Date(s.submittedAt).toLocaleString('en-GB') : s.timestamp %></p>
        </div>
      </div>
      <p class="text-gray-700 whitespace-pre-line bg-gray-50 rounded-lg p-4 text-sm"><%= s.message || 'No message provided.' %></p>
      <div class="flex gap-2 mt-4">
        <form method="POST" action="/admin/submissions/<%= s._id %>/toggle">
          <button type="submit" class="<%= handled ? 'bg-gray-400 hover:bg-gray-500' : 'bg-green-500 hover:bg-green-600' %> text-white px-4 py-1.5 rounded-full text-xs font-semibold transition">
            <i class="fas <%= handled ? 'fa-undo' : 'fa-check' %> mr-1"></i><%= handled ? 'Mark as New' : 'Mark as Handled' %>
          </button>
        </form>
        <form method="POST" action="/admin/submissions/<%= s._id %>/delete" onsubmit="return confirm('Delete this enquiry permanently?')">
          <button type="submit" class="bg-red-500 text-white px-4 py-1.5 rounded-full text-xs font-semibold hover:bg-red-700 transition">
            <i class="fas fa-trash mr-1"></i>Delete
          </button>
        </form>
      </div>
    </div>
  <% }) %>
</div>

<%- include('partials/admin-footer') %>
