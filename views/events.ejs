<%- include('partials/header', { activePage: 'events', title: 'Church Calendar', metaDescription: 'Upcoming services, prayer meetings, fasting Sundays, trainings and special events at Revival Fellowship International, Butha-Buthe.' }) %>

<section class="hero relative h-72 bg-cover bg-center" style="background-image: url('/images/wide.jpg')">
  <div class="absolute inset-0 bg-black bg-opacity-60 flex items-center justify-center">
    <div class="text-center text-white px-4">
      <h1 class="text-5xl md:text-6xl font-bold font-heading">Church Calendar</h1>
      <p class="mt-4 text-xl text-gray-200">Services, gatherings and special events at RFI</p>
    </div>
  </div>
</section>

<% const fmt = (d, opts) => new Date(d).toLocaleDateString('en-GB', opts); %>
<% const styleFor = c => categoryStyles[c] || categoryStyles.special; %>

<div class="max-w-6xl mx-auto px-6 py-16">

  <!-- Next event highlight -->
  <% if (nextEvent) { const st = styleFor(nextEvent.category); %>
    <div class="bg-gradient-to-r from-primary to-accent text-white rounded-2xl shadow-2xl p-8 md:p-10 mb-14 flex flex-col md:flex-row items-center gap-8">
      <div class="bg-white text-primary rounded-2xl w-28 h-28 flex flex-col items-center justify-center flex-shrink-0 shadow-lg">
        <span class="text-sm font-bold uppercase"><%= fmt(nextEvent.date, { month: 'short' }) %></span>
        <span class="text-5xl font-bold leading-none"><%= fmt(nextEvent.date, { day: 'numeric' }) %></span>
      </div>
      <div class="text-center md:text-left flex-1">
        <p class="text-secondary font-bold uppercase tracking-widest text-sm mb-2">Next Up</p>
        <h2 class="text-3xl md:text-4xl font-bold mb-2"><%= nextEvent.name %></h2>
        <p class="text-teal-100">
          <i class="fas fa-calendar mr-1"></i><%= fmt(nextEvent.date, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %>
          <% if (nextEvent.time) { %> &bull; <i class="fas fa-clock mr-1"></i><%= nextEvent.time %><% } %>
          &bull; <i class="fas <%= st.icon %> mr-1"></i><%= st.label %>
        </p>
      </div>
      <a href="/inquire?type=information-request" class="bg-secondary hover:bg-orange-600 text-white font-bold py-3 px-8 rounded-full transition flex-shrink-0">
        Ask About It
      </a>
    </div>
  <% } %>

  <div class="grid lg:grid-cols-3 gap-12">

    <!-- Upcoming events by month -->
    <div class="lg:col-span-2">
      <h2 class="text-3xl font-bold text-primary mb-8"><i class="fas fa-calendar-alt mr-2 text-secondary"></i>Upcoming Events</h2>

      <% if (months.length === 0) { %>
        <div class="bg-white rounded-2xl shadow p-12 text-center text-gray-500">
          <i class="fas fa-calendar-times text-5xl text-gray-300 mb-4"></i>
          <p class="text-xl">No upcoming dated events right now. Check back soon!</p>
        </div>
      <% } %>

      <div class="space-y-10">
        <% months.forEach(month => { %>
          <section>
            <h3 class="text-xl font-bold text-gray-700 border-b-2 border-secondary pb-2 mb-4"><%= month.label %></h3>
            <ul class="space-y-3">
              <% month.events.forEach(e => { const st = styleFor(e.category); %>
                <li class="bg-white rounded-xl shadow hover:shadow-lg transition flex items-center gap-5 p-4">
                  <div class="text-center w-16 flex-shrink-0">
                    <p class="text-xs font-bold text-gray-400 uppercase"><%= fmt(e.date, { weekday: 'short' }) %></p>
                    <p class="text-3xl font-bold text-primary leading-none"><%= fmt(e.date, { day: 'numeric' }) %></p>
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="font-bold text-gray-800 text-lg"><%= e.name %></p>
                    <% if (e.time) { %><p class="text-sm text-gray-500"><i class="fas fa-clock mr-1"></i><%= e.time %></p><% } %>
                  </div>
                  <span class="<%= st.color %> text-white text-xs font-bold px-3 py-1 rounded-full whitespace-nowrap hidden sm:inline-block">
                    <i class="fas <%= st.icon %> mr-1"></i><%= st.label %>
                  </span>
                </li>
              <% }) %>
            </ul>
          </section>
        <% }) %>
      </div>

      <% if (past.length > 0) { %>
        <details class="mt-12 bg-gray-100 rounded-xl p-5">
          <summary class="cursor-pointer font-semibold text-gray-600">Past events (<%= past.length %>)</summary>
          <ul class="mt-4 space-y-2 text-sm text-gray-500">
            <% past.forEach(e => { %>
              <li class="flex justify-between border-b border-gray-200 pb-2">
                <span><%= e.name %></span>
                <span><%= fmt(e.date, { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
              </li>
            <% }) %>
          </ul>
        </details>
      <% } %>
    </div>

    <!-- Sidebar: regular gatherings -->
    <aside class="space-y-8">
      <div class="bg-white rounded-2xl shadow-lg p-6">
        <h2 class="text-xl font-bold text-primary mb-5"><i class="fas fa-redo mr-2 text-secondary"></i>Regular Gatherings</h2>
        <% if (recurring.length === 0) { %>
          <p class="text-gray-500 text-sm">No regular gatherings listed.</p>
        <% } %>
        <ul class="space-y-4">
          <% recurring.forEach(e => { const st = styleFor(e.category); %>
            <li class="flex items-start gap-3">
              <span class="<%= st.color %> text-white w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0">
                <i class="fas <%= st.icon %> text-sm"></i>
              </span>
              <div>
                <p class="font-semibold text-gray-800"><%= e.name %></p>
                <p class="text-sm text-gray-500"><%= e.date %><% if (e.time) { %> &bull; <%= e.time %><% } %></p>
              </div>
            </li>
          <% }) %>
        </ul>
      </div>

      <div class="bg-white rounded-2xl shadow-lg p-6">
        <h2 class="text-xl font-bold text-primary mb-4"><i class="fas fa-tags mr-2 text-secondary"></i>Event Types</h2>
        <ul class="space-y-2 text-sm">
          <% Object.values(categoryStyles).forEach(st => { %>
            <li class="flex items-center gap-2">
              <span class="<%= st.color %> w-3 h-3 rounded-full inline-block"></span><%= st.label %>
            </li>
          <% }) %>
        </ul>
      </div>

      <div class="bg-gradient-to-br from-primary/10 to-secondary/10 rounded-2xl p-6 text-center">
        <i class="fas fa-map-marker-alt text-3xl text-secondary mb-3"></i>
        <p class="font-bold text-gray-800">A1 Road, Opposite Usave</p>
        <p class="text-gray-600 text-sm mb-4">Behind BEDCO, Butha-Buthe 400, Lesotho</p>
        <a href="/join" class="inline-block bg-primary text-white px-6 py-2 rounded-full font-semibold hover:bg-accent transition">Get Involved</a>
      </div>
    </aside>
  </div>
</div>

<%- include('partials/footer') %>
