<%- include('partials/admin-header', { title, currentSection }) %>

<div class="flex justify-between items-center mb-8">
  <p class="text-gray-500"><%= ministries.length %> minist<%= ministries.length !== 1 ? 'ries' : 'ry' %> total</p>
  <a href="/admin/ministries/new" class="bg-primary text-white px-5 py-2 rounded-full font-semibold hover:bg-accent transition">
    <i class="fas fa-plus mr-2"></i>Add Ministry
  </a>
</div>

<% if (ministries.length === 0) { %>
  <div class="bg-white rounded-2xl shadow p-16 text-center text-gray-400">
    <i class="fas fa-hands-praying text-5xl mb-4"></i>
    <p class="text-lg mb-4">No ministries yet.</p>
    <a href="/admin/ministries/new" class="bg-primary text-white px-6 py-2 rounded-full font-semibold hover:bg-accent transition">Add First Ministry</a>
  </div>
<% } %>

<div class="grid md:grid-cols-2 xl:grid-cols-3 gap-6">
  <% ministries.forEach(m => { %>
    <div class="bg-white rounded-2xl shadow overflow-hidden flex flex-col">
      <% if (m.image) { %>
        <img src="<%= img(m.image) %>" alt="<%= m.name %>" class="w-full h-36 object-cover">
      <% } else { %>
        <div class="w-full h-36 bg-gray-200 flex items-center justify-center text-gray-400"><i class="fas fa-church text-4xl"></i></div>
      <% } %>
      <div class="p-5 flex-1 flex flex-col">
        <p class="font-bold text-gray-800 text-lg"><%= m.name %></p>
        <p class="text-xs text-gray-500 mb-2"><i class="fas fa-clock mr-1"></i><%= m.schedule || '—' %></p>
        <p class="text-sm text-gray-600 flex-1"><%= m.description %></p>
        <div class="flex gap-2 pt-4 mt-4 border-t">
          <a href="/admin/ministries/<%= m._id %>/edit" class="bg-secondary text-white px-4 py-1.5 rounded-full text-xs font-semibold hover:bg-orange-600 transition">
            <i class="fas fa-edit mr-1"></i>Edit
          </a>
          <form method="POST" action="/admin/ministries/<%= m._id %>/delete" onsubmit="return confirm('Delete this ministry?')">
            <button type="submit" class="bg-red-500 text-white px-4 py-1.5 rounded-full text-xs font-semibold hover:bg-red-700 transition">
              <i class="fas fa-trash mr-1"></i>Delete
            </button>
          </form>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<%- include('partials/admin-footer') %>
