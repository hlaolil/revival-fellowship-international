<%- include('partials/header', { activePage: 'home', title: 'Home', metaDescription: 'Revival Fellowship International – ' + siteContent.heroTagline + ' Join us in Butha-Buthe, Lesotho.' }) %>

<!-- ANNOUNCEMENT BANNER -->
<% if (siteContent.announcementEnabled && siteContent.announcementText) { %>
<div class="announcement-banner text-white py-3 px-4 text-center text-sm font-semibold">
  <i class="fas fa-bullhorn mr-2"></i><%= siteContent.announcementText %>
  <% if (siteContent.announcementLink) { %>
    &nbsp;<a href="<%= siteContent.announcementLink %>" class="underline hover:no-underline ml-1"><%= siteContent.announcementLinkText || 'Learn more' %> &rarr;</a>
  <% } %>
</div>
<% } %>

<!-- HERO SECTION -->
<section class="relative h-96 md:h-screen max-h-screen overflow-hidden">
  <%- include('partials/hero-image', { desktop: 'hero.webp', mobile: 'hero1.webp', alt: 'Worship service at RFI' }) %>
  <div class="absolute inset-0 hero-overlay flex items-center justify-center">
    <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-white">
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold font-heading mb-4 hero-title">
        Revival Fellowship International
      </h1>
      <p class="text-lg sm:text-xl md:text-2xl mb-10 text-gray-200 hero-tagline">
        <%= siteContent.heroTagline %>
      </p>
      <div class="flex flex-wrap justify-center gap-4 hero-cta">
        <a href="/join" class="inline-block bg-white text-primary hover:bg-secondary hover:text-white font-bold py-4 px-10 rounded-full text-xl shadow-2xl transform hover:scale-105 transition duration-300">
          Get Involved
        </a>
        <a href="/sermons" class="inline-block bg-transparent border-2 border-white text-white hover:bg-white hover:text-primary font-bold py-4 px-10 rounded-full text-xl transform hover:scale-105 transition duration-300">
          Watch Sermons
        </a>
      </div>
    </div>
  </div>
  <div class="scroll-indicator hidden md:block">
    <i class="fas fa-chevron-down text-2xl"></i>
  </div>
</section>

<!-- THREE INFO CARDS -->
<main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 grid md:grid-cols-3 gap-10">

  <!-- Upcoming Events -->
  <div class="info-card bg-white p-8 rounded-xl shadow-lg hover:shadow-2xl transition">
    <h2 class="text-2xl font-bold text-primary mb-4 text-center">
      <i class="fas fa-calendar-alt mr-2"></i>Upcoming Events
    </h2>
    <ul class="space-y-3 text-gray-700">
      <% if (upcomingEvents && upcomingEvents.length > 0) { %>
        <% upcomingEvents.forEach(event => { %>
          <li class="border-b pb-2">
            <strong><%= event.name %></strong><br>
            <em class="text-sm text-gray-500">
              <%= new Date(event.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %>
            </em>
          </li>
        <% }) %>
      <% } else { %>
        <li class="text-center text-gray-500">No upcoming events in the next 3 months</li>
      <% } %>
    </ul>
    <div class="mt-6 text-center">
      <a href="/events" class="inline-block text-primary font-semibold hover:underline">View Full Calendar &rarr;</a>
    </div>
  </div>

  <!-- Contact Info -->
  <div class="info-card bg-white p-8 rounded-xl shadow-lg hover:shadow-2xl transition">
    <h2 class="text-2xl font-bold text-primary mb-4 text-center">
      <i class="fas fa-address-card mr-2"></i>Contact Us
    </h2>
    <p class="text-left leading-relaxed text-gray-700">
      <i class="fas fa-map-marker-alt text-secondary mr-2"></i><%= site.addressLine1 %><br>
      <span class="ml-6"><%= site.addressLine2 %></span><br>
      <span class="ml-6"><%= site.country %></span>
    </p>
    <p class="text-left leading-relaxed text-gray-700 mt-4">
      <i class="fas fa-envelope text-secondary mr-2"></i>
      <a href="mailto:<%= site.email %>" class="hover:text-primary transition"><%= site.email %></a>
    </p>
    <p class="text-left leading-relaxed text-gray-700 mt-2">
      <i class="fas fa-phone text-secondary mr-2"></i>
      <a href="tel:<%= tel(site.phone) %>" class="hover:text-primary transition"><%= site.phone %></a>
    </p>
    <p class="text-left leading-relaxed text-gray-700 mt-2">
      <i class="fab fa-whatsapp text-green-500 mr-2"></i>
      <a href="https://wa.me/<%= site.whatsapp %>" target="_blank" rel="noopener" class="hover:text-green-600 transition font-semibold">Message us on WhatsApp</a>
    </p>
    <div class="mt-6 text-center">
      <a href="/join" class="inline-block bg-primary text-white px-6 py-3 rounded-full hover:bg-accent transition font-semibold">
        Make an Enquiry
      </a>
    </div>
  </div>

  <!-- Location Map -->
  <div class="info-card bg-white p-8 rounded-xl shadow-lg hover:shadow-2xl transition">
    <h2 class="text-2xl font-bold text-primary mb-4 text-center">
      <i class="fas fa-map mr-2"></i>Our Location
    </h2>
    <iframe
      src="<%= site.mapEmbedUrl %>"
      class="w-full h-56 rounded-lg border-0"
      allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="RFI Location Map">
    </iframe>
    <p class="text-center text-sm text-gray-500 mt-3"><%= site.addressLine1 %>, <%= site.addressLine2 %>, <%= site.country %></p>
    <p class="text-center mt-2"><a href="/visit" class="text-primary font-semibold hover:underline text-sm">Plan your visit &rarr;</a></p>
  </div>
</main>

<!-- OUR SERVICES SECTION -->
<section class="bg-gray-100 py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-16 text-primary"><span class="section-heading">Our Services</span></h2>
    <div class="grid md:grid-cols-3 gap-10">
      <% const cards = [
        site.midweekName ? { name: site.midweekName, schedule: site.midweekTime, contact: site.midweekContact, image: 'prayer.jpg' } : null,
        latestSermon ? { name: latestSermon.title, sermon: latestSermon } : null,
        { name: 'Sunday Service', schedule: site.sundayServiceTime, contact: site.sundayServiceContact, image: 'service.jpg' },
      ].filter(Boolean); %>
      <% cards.forEach(card => { %>
        <div class="service-card bg-white rounded-xl overflow-hidden shadow-xl hover:shadow-2xl transform hover:-translate-y-3 transition duration-300">
          <div class="card-img-wrap">
          <% if (card.sermon) { %>
            <iframe class="w-full h-64" src="https://www.youtube.com/embed/<%= card.sermon.videoId %>" title="<%= card.name %>" loading="lazy" allowfullscreen></iframe>
          <% } else { %>
            <img src="/images/<%= card.image %>" alt="<%= card.name %>" class="w-full h-64 object-cover" loading="lazy">
          <% } %>
          </div>
          <div class="p-6 text-center">
            <h3 class="text-xl font-bold text-primary mb-3"><%= card.name %></h3>
            <% if (card.sermon) { %>
              <p class="text-gray-600 mt-1">Latest sermon &bull; <%= new Date(card.sermon.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %></p>
              <a href="/sermons" class="inline-block mt-3 text-primary font-semibold hover:underline">View All Sermons &rarr;</a>
            <% } else { %>
              <p class="text-gray-700"><strong>Schedule:</strong> <%= card.schedule %></p>
              <% if (card.contact) { %><p class="text-gray-700 mt-2"><strong>Contact:</strong> <%= card.contact %></p><% } %>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- PASTOR'S MESSAGE -->
<% if (siteContent.pastorMessageEnabled && siteContent.pastorMessageText) { %>
<section class="bg-white py-16">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <i class="fas fa-church text-4xl text-secondary mb-6"></i>
    <h2 class="text-3xl md:text-4xl font-bold text-primary mb-8"><%= siteContent.pastorMessageTitle %></h2>
    <div class="bg-gradient-to-br from-primary/5 to-secondary/5 rounded-2xl p-10 shadow-lg">
      <i class="fas fa-quote-left text-secondary text-3xl mb-4"></i>
      <% siteContent.pastorMessageText.split('\n\n').forEach(para => { %>
        <p class="text-gray-700 text-xl leading-relaxed mb-4 italic"><%= para %></p>
      <% }) %>
      <div class="mt-6 flex items-center justify-center gap-3">
        <div class="w-12 h-12 bg-primary rounded-full flex items-center justify-center text-white font-bold text-xl">
          <%= siteContent.pastorMessageAuthor.charAt(0) %>
        </div>
        <p class="font-bold text-primary text-lg"><%= siteContent.pastorMessageAuthor %></p>
      </div>
    </div>
  </div>
</section>
<% } %>

<!-- SCRIPTURE OF THE WEEK -->
<% if (siteContent.scriptureEnabled && siteContent.scriptureVerse) { %>
<section class="bg-accent text-white py-14">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <p class="text-secondary font-bold text-sm uppercase tracking-widest mb-4">Scripture of the Week</p>
    <i class="fas fa-bible text-4xl text-secondary mb-6"></i>
    <blockquote class="text-2xl md:text-3xl font-heading italic leading-relaxed mb-6">
      "<%= siteContent.scriptureVerse %>"
    </blockquote>
    <% if (siteContent.scriptureReference) { %>
      <p class="text-teal-200 text-lg font-semibold">&mdash; <%= siteContent.scriptureReference %></p>
    <% } %>
  </div>
</section>
<% } %>

<!-- TESTIMONIALS -->
<% if (testimonials && testimonials.length > 0) { %>
<section class="bg-white py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-4 text-primary">
      <span class="section-heading"><i class="fas fa-quote-left mr-2 text-secondary"></i>What Our Members Say</span>
    </h2>
    <p class="text-center text-gray-500 mb-12 text-lg">Stories of faith, growth, and community from the RFI family</p>
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      <% testimonials.forEach(t => { %>
        <div class="testimonial-card rounded-2xl p-6 flex flex-col hover:shadow-lg transition">
          <i class="fas fa-quote-left text-secondary text-2xl mb-4"></i>
          <p class="text-gray-700 text-sm leading-relaxed flex-1 italic">"<%= t.text %>"</p>
          <div class="mt-6 flex items-center gap-3">
            <div class="w-10 h-10 bg-primary rounded-full flex items-center justify-center text-white font-bold text-lg flex-shrink-0">
              <%= t.name.charAt(0) %>
            </div>
            <div>
              <p class="font-bold text-gray-800 text-sm"><%= t.name %></p>
              <p class="text-xs text-gray-500"><%= t.role %></p>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- LATEST NEWS STRIP -->
<section class="news-strip bg-primary text-white py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl font-bold mb-4"><i class="fas fa-newspaper mr-2"></i>Stay Up To Date</h2>
    <p class="text-teal-100 mb-6 text-lg">Read the latest announcements, events, and news from RFI.</p>
    <a href="/news" class="inline-block bg-secondary hover:bg-orange-600 text-white font-bold py-3 px-10 rounded-full text-lg transition">
      View News &amp; Announcements
    </a>
  </div>
</section>

<%- include('partials/footer') %>
