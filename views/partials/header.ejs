<%
  const pageDescription = typeof metaDescription !== 'undefined' ? metaDescription : 'Revival Fellowship International – An assembly of faithful stewards of the manifold grace of God. Based in Butha-Buthe, Lesotho.';
  const absolute = u => /^https?:\/\//.test(u) ? u : baseUrl + u;
  const shareImage = absolute(typeof ogImage !== 'undefined' && ogImage ? img(ogImage) : '/images/og-image.jpg');
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <meta name="author" content="Letlotlo Hlaoli">
  <meta name="description" content="<%= pageDescription %>">
  <meta name="keywords" content="Revival Fellowship International, RFI, church, Lesotho, Butha-Buthe, ministry, worship, discipleship">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Revival Fellowship International">
  <meta property="og:title" content="<%= title %> - Revival Fellowship International">
  <meta property="og:description" content="<%= pageDescription %>">
  <meta property="og:url" content="<%= baseUrl + (typeof currentPath !== 'undefined' ? currentPath : '/') %>">
  <meta property="og:image" content="<%= shareImage %>">
  <meta property="og:locale" content="en_LS">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= title %> - Revival Fellowship International">
  <meta name="twitter:description" content="<%= pageDescription %>">
  <meta name="twitter:image" content="<%= shareImage %>">

  <title><%= title %> - Revival Fellowship International</title>

  <link rel="stylesheet" href="/styles/site.css?v=<%= assetVersion %>">

  <!-- Font Awesome -->
  <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css"/>
  <link rel="icon" href="/images/fav.jpg" type="image/x-icon">

</head>
<body class="bg-gray-50 text-gray-800">

<% if (typeof activePage === 'undefined') { activePage = ''; } %>
<%
  const navGroups = [
    { label: 'About', items: [
      { href: '/about',      page: 'about',      label: 'Who We Are',  icon: 'fa-church' },
      { href: '/ministries', page: 'ministries', label: 'Ministries',  icon: 'fa-hands-praying' },
      { href: '/gallery',    page: 'gallery',    label: 'Gallery',     icon: 'fa-images' },
    ] },
    { label: "What's On", items: [
      { href: '/events', page: 'events', label: 'Church Calendar',        icon: 'fa-calendar-alt' },
      { href: '/news',   page: 'news',   label: 'News & Announcements',   icon: 'fa-newspaper' },
    ] },
    { label: 'Sermons', href: '/sermons', page: 'sermons' },
    { label: 'Get Involved', cta: true, items: [
      { href: '/visit', page: 'visit', label: 'Plan Your Visit',  icon: 'fa-map-location-dot' },
      { href: '/join',  page: 'join',  label: 'Connect With Us',  icon: 'fa-hand-holding-heart' },
      ...(site.givingEnabled ? [{ href: '/give', page: 'give', label: 'Give', icon: 'fa-gift' }] : []),
    ] },
  ];
  const groupActive = g => g.items ? g.items.some(i => i.page === activePage) : g.page === activePage;
%>
<header class="bg-primary text-white shadow-lg relative z-40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex justify-between items-center">
    <a href="/" class="flex items-center space-x-4 hover:text-secondary transition" aria-label="Revival Fellowship International – Home">
      <img src="/images/logo.webp" alt="RFI Logo" class="h-20 w-auto rounded-lg sm:h-24 lg:h-28">
      <span class="text-2xl font-bold hidden sm:block">Revival Fellowship International</span>
    </a>

    <!-- Hamburger -->
    <button id="menu-btn" class="lg:hidden text-white focus:outline-none" aria-label="Toggle menu" aria-controls="mobile-menu" aria-expanded="false">
      <i class="fas fa-bars text-3xl"></i>
    </button>

    <!-- Desktop Navigation -->
    <nav id="nav-menu" class="hidden lg:flex items-center space-x-2" aria-label="Main">
      <% navGroups.forEach(g => { %>
        <% if (g.items) { %>
          <div class="nav-dropdown relative">
            <button type="button" aria-haspopup="true" class="<%= g.cta
              ? 'ml-2 bg-secondary hover:bg-white hover:text-primary text-white font-bold px-6 py-3 rounded-full shadow' + (groupActive(g) ? ' ring-2 ring-white' : '')
              : 'px-4 py-3 rounded-md hover:bg-secondary' + (groupActive(g) ? ' bg-secondary font-bold' : '') %> transition flex items-center gap-2">
              <%= g.label %> <i class="fas fa-chevron-down text-xs"></i>
            </button>
            <div class="dropdown-menu absolute right-0 top-full pt-2 w-60">
              <div class="bg-white text-gray-800 rounded-xl shadow-2xl overflow-hidden py-2">
                <% g.items.forEach(i => { %>
                  <a href="<%= i.href %>" class="flex items-center gap-3 px-5 py-3 hover:bg-teal-50 hover:text-primary transition <%= i.page === activePage ? 'text-primary font-bold bg-teal-50' : '' %>">
                    <i class="fas <%= i.icon %> text-secondary w-5 text-center"></i><%= i.label %>
                  </a>
                <% }) %>
              </div>
            </div>
          </div>
        <% } else { %>
          <a href="<%= g.href %>" class="px-4 py-3 rounded-md hover:bg-secondary transition <%= groupActive(g) ? 'bg-secondary font-bold' : '' %>"><%= g.label %></a>
        <% } %>
      <% }) %>
    </nav>
  </div>

  <!-- Mobile Menu -->
  <nav id="mobile-menu" class="lg:hidden hidden bg-primary border-t border-teal-700 pb-4" aria-label="Main">
    <% navGroups.forEach(g => { %>
      <% if (g.items) { %>
        <p class="px-6 pt-4 pb-1 text-xs font-bold uppercase tracking-widest <%= g.cta ? 'text-secondary mt-2 border-t border-teal-700 pt-5' : 'text-teal-200' %>"><%= g.label %></p>
        <% g.items.forEach(i => { %>
          <a href="<%= i.href %>" class="flex items-center gap-3 px-6 py-3 hover:bg-secondary <%= i.page === activePage ? 'bg-secondary font-bold' : '' %>">
            <i class="fas <%= i.icon %> w-5 text-center text-teal-200"></i><%= i.label %>
          </a>
        <% }) %>
      <% } else { %>
        <a href="<%= g.href %>" class="block px-6 py-4 mt-2 border-t border-teal-700 hover:bg-secondary <%= groupActive(g) ? 'bg-secondary font-bold' : '' %>"><%= g.label %></a>
      <% } %>
    <% }) %>
  </nav>
</header>

<script>
  document.getElementById('menu-btn').addEventListener('click', function () {
    const hidden = document.getElementById('mobile-menu').classList.toggle('hidden');
    this.setAttribute('aria-expanded', String(!hidden));
  });
</script>
